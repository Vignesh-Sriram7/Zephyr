#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    chosen {
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};


    aliases{
        motor-0=&motor_0;
    };

    my-pwm-motors {
        compatible = "pwm-leds"; // Use a standard compatible string
        motor_0: pwm_motor_0 {
            pwms = <&ledc0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
        };
    };

};

&flash0 {
    /* DELETE the default partition table provided by the board files */
    /delete-node/ partitions;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@1000 {
			label = "mcuboot";
			reg = <0x00001000 DT_SIZE_K(60)>;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(1856)>;
		};

		slot1_partition: partition@1E0000 {
			label = "image-1";
			reg = <0x001E0000 DT_SIZE_K(1856)>;
		};

		storage_partition: partition@3B0000 {
			label = "storage";
			reg = <0x003B0000 DT_SIZE_K(256)>;
		};

		scratch_partition: partition@3F0000 {
			   label = "image-scratch";
			   reg = <0x003F0000 DT_SIZE_K(64)>;
		};
	};
};

// Handles all the PWM tasks. Most flexible hardware timer on the ESP32; Primary ESP32 PWM peripheral
// LEDC takes care of generating raw eelctrical pulses
&ledc0 {
    pinctrl-0 = <&motorctrl_0>;
	pinctrl-names = "default";
    status = "okay";
};


&pinctrl {
        motorctrl_0: motor-0 {
	        group1 {
		        pinmux = <LEDC_CH0_GPIO13>; // Routes PWM channel 0 to pin 13
			output-enable; // Configures pin 13 as output explicitly
		};
	};
};