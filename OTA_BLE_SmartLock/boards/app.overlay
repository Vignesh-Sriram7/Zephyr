/ {
    chosen {
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0000 {
			label = "mcuboot";
			reg = <0x0000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 DT_SIZE_K(1856)>;
		};

		slot1_partition: partition@1E0000 {
			label = "image-1";
			reg = <0x1E0000 DT_SIZE_K(1856)>;
		};

		storage_partition: partition@3B0000 {
			label = "storage";
			reg = <0x3B0000 DT_SIZE_K(256)>;
		};

		scratch_partition: partition@3F0000 {
			   label = "image-scratch";
			   reg = <0x3F0000 DT_SIZE_K(64)>;
		};
		};
	};

