/ {

    aliases {
        my-temp = &my_bme280_i2c;   // Alias for BME280 temperature sensor
    };
};


// The BME280 sensor is defined as a child of the I2C1 bus with its compatible and I2C address
&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    /* The sensor is a child of the bus */
    my_bme280_i2c: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};

// USART2 is enabled for serial communication with the host computer for debugging and telemetry output
&usart2 {
    status = "okay";
    current-speed = <115200>;
};

&usb {
	status = "okay";
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};